---
import Base from "../layouts/base.astro";
---

<Base 
    index="true"
    title="Outreach"
    desc="Outreach of Bitflip Robotics"
>
    <Fragment slot="head">
        <link rel="canonical" href="https://www.bitflip.club/outreach/">
    </Fragment>

    <header>
            <div class="header-content">
                <h1>Outreach</h1>
            </div>
        </header>

        <section class="section-alt">
            <div class="section-content">
                <h2><strong>Computer Vision In Robotics</strong></h2>
                <h3 style="font-size:1.6rem; color:lightgray; margin: 0px 0px 32px 0px; padding: 0">BioBuzz Kickoff Presentation</h3>
                <p style="text-align:center; font-size:1.5rem;">
                    <a href="https://docs.google.com/presentation/d/1YlxpYBev2GK0whfx51EG7bt2hot7hAE131Cg-oEd2zY/edit?usp=sharing" target="_blank">Slides</a><br> <a href="https://youtu.be/4gRbMv8twUY" target="_blank">Recording</a>
                </p>
            </div>
        </section>
</Base>